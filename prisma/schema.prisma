datasource db {
  provider = "sqlite" // Configurable for Postgres in production: url = env("DATABASE_URL")
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  INSTITUTE_ADMIN
  TEACHER
  TEACHING_ASSISTANT
  STUDENT
}

enum StreamSource {
  WEBRTC_NATIVE
  RTMP_STUDIO
  EXTERNAL_STREAM
}

enum SessionState {
  SCHEDULED
  LIVE
  PAUSED
  ENDED
  ARCHIVED
}

model Organization {
  id               String         @id @default(uuid())
  name             String
  slug             String         @unique
  customDomain     String?        @unique
  logoUrl          String?
  planTier         String         @default("PRO_ACADEMY") // STARTER, PRO_ACADEMY, ENTERPRISE
  subscriptionEnd  DateTime?
  storageQuotaGb   Int            @default(100)
  users            User[]
  courses          Course[]
  contests         Contest[]
  createdAt        DateTime       @default(now())
}

model User {
  id               String               @id @default(uuid())
  orgId            String
  organization     Organization         @relation(fields: [orgId], references: [id])
  email            String               @unique
  phone            String?
  fullName         String
  passwordHash     String
  role             Role                 @default(STUDENT)
  studentRollNo    String?
  deviceTokens     DeviceFingerprint[]
  enrollments      Enrollment[]
  createdCourses   Course[]             @relation("TeacherCourses")
  quizSubmissions  LiveQuizSubmission[]
  codeSubmissions  CodeSubmission[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([orgId, role])
}

model DeviceFingerprint {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceHash       String    // Hardware / Canvas / OS fingerprint
  deviceName       String    // e.g. "Windows 11 PC - Chrome" or "iPad Pro"
  platform         String    // "WINDOWS", "MACOS", "ANDROID", "IOS", "WEB"
  refreshTokenHash String
  lastActiveIp     String
  isActive         Boolean   @default(true)
  lastSeenAt       DateTime  @default(now())

  @@unique([userId, deviceHash])
}

model Course {
  id               String         @id @default(uuid())
  orgId            String
  organization     Organization   @relation(fields: [orgId], references: [id])
  teacherId        String
  teacher          User           @relation("TeacherCourses", fields: [teacherId], references: [id])
  title            String
  description      String
  thumbnailUrl     String?
  price            Float          @default(0.0)
  isPublished      Boolean        @default(false)
  modules          CourseModule[]
  enrollments      Enrollment[]
  createdAt        DateTime       @default(now())
}

model CourseModule {
  id               String         @id @default(uuid())
  courseId         String
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  orderIndex       Int
  lectures         Lecture[]
  createdAt        DateTime       @default(now())
}

model Lecture {
  id               String         @id @default(uuid())
  moduleId         String
  module           CourseModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title            String
  orderIndex       Int
  isLiveClass      Boolean        @default(false)
  streamSource     StreamSource   @default(WEBRTC_NATIVE)
  scheduledStart   DateTime?
  scheduledEnd     DateTime?
  recordingUrl     String?        // Encrypted HLS Master Playlist URL (.m3u8)
  drmKeyId         String?        // Key ID for Multi-DRM (Widevine/Fairplay)
  allowOfflineDownload Boolean    @default(true) // Native app only
  liveSession      LiveSession?
  resources        LectureResource[]
  createdAt        DateTime       @default(now())
}

model LiveSession {
  id               String         @id @default(uuid())
  lectureId        String         @unique
  lecture          Lecture        @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  sessionState     SessionState   @default(SCHEDULED)
  sfuRoomId        String?
  rtmpStreamKey    String?        @unique
  startedAt        DateTime?
  endedAt          DateTime?
  quizzes          LiveQuiz[]
  alertTallies     AudioVideoAlert[]
}

model AudioVideoAlert {
  id               String         @id @default(uuid())
  sessionId        String
  session          LiveSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId        String
  issueType        String         // "MIC_INAUDIBLE", "CAMERA_FROZEN", "LAGGY_FEED"
  reportedAt       DateTime       @default(now())

  @@index([sessionId, reportedAt])
}

model LiveQuiz {
  id               String               @id @default(uuid())
  sessionId        String
  session          LiveSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionText     String
  optionsJson      String               // JSON string array of choices
  correctOptionIdx Int
  timeLimitSeconds Int                  @default(30)
  isActive         Boolean              @default(false)
  launchedAt       DateTime?
  submissions      LiveQuizSubmission[]
}

model LiveQuizSubmission {
  id               String         @id @default(uuid())
  quizId           String
  quiz             LiveQuiz       @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId        String
  student          User           @relation(fields: [studentId], references: [id])
  selectedOption   Int
  isCorrect        Boolean
  elapsedMillis    Int            // Server-verified millisecond response time
  submittedAt      DateTime       @default(now())

  @@unique([quizId, studentId])
  @@index([quizId, isCorrect, elapsedMillis])
}

model LiveChatMessage {
  id          String   @id @default(uuid())
  sessionId   String
  senderName  String
  senderRole  String   // "TEACHER" | "STUDENT" | "TA"
  text        String
  isPinned    Boolean  @default(false)
  isQuestion  Boolean  @default(false)
  upvotes     Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([sessionId, createdAt])
}

model Contest {
  id               String               @id @default(uuid())
  orgId            String
  organization     Organization         @relation(fields: [orgId], references: [id])
  title            String
  description      String
  startTime        DateTime
  endTime          DateTime
  isAiDisabled     Boolean              @default(true) // Hard-locks AI during contest
  challenges       ContestChallenge[]
  submissions      CodeSubmission[]
}

model ContestChallenge {
  id               String               @id @default(uuid())
  contestId        String
  contest          Contest              @relation(fields: [contestId], references: [id], onDelete: Cascade)
  title            String
  problemStatement String
  allowedLanguages String               // Comma separated e.g. "python,cpp,java,javascript"
  timeLimitSec     Float                @default(2.0)
  memoryLimitMb    Int                  @default(256)
  testCasesJson    String               // JSON string [{input, expectedOutput, isHidden}]
  points           Int                  @default(100)
}

model CodeSubmission {
  id               String               @id @default(uuid())
  contestId        String
  contest          Contest              @relation(fields: [contestId], references: [id])
  studentId        String
  student          User                 @relation(fields: [studentId], references: [id])
  language         String
  sourceCode       String
  executionResult  String               // "ACCEPTED", "WRONG_ANSWER", "TIME_LIMIT_EXCEEDED"
  score            Int                  @default(0)
  submittedAt      DateTime             @default(now())
}

model Enrollment {
  id               String         @id @default(uuid())
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt       DateTime       @default(now())

  @@unique([userId, courseId])
}

model LectureResource {
  id               String         @id @default(uuid())
  lectureId        String
  lecture          Lecture        @relation(fields: [lectureId], references: [id], onDelete: Cascade)
  title            String
  fileUrl          String
  fileSizeMb       Float
  isDownloadable   Boolean        @default(true)
  pushedInLiveAt   DateTime?
}
